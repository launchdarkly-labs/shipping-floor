# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Required: LaunchDarkly server-side SDK key.
#
# LaunchDarkly is the sole source of musical truth. Each musician's model,
# parameters, persona, gain ceiling, AND musical vocabulary come from an AI
# Config variation assembled from versioned prompt snippets. There is no local
# fallback on purpose: if this key is wrong, the band has no vocabulary at all
# and will hold rather than invent one.
LAUNCHDARKLY_SDK_KEY=sdk-...

# Required for a first run: the project you just created. Do not point this
# at an existing Shipping Floor demo unless you intend to reuse it.
LAUNCHDARKLY_PROJECT_KEY=your-new-project-key

# Optional: the listener audience carried in the evaluation context. This is a
# targeting dimension — `lounge` is served a different shelf of vocabulary than
# `peak-hour`, by rule, with no code change.
# DEMO_AUDIENCE=peak-hour

# Optional: also call variationDetail() to recover WHICH targeting rule matched.
# Costs a second evaluation event per generation, so it is off by default.
# LD_EXPLAIN=1

# Optional: HTTP/WebSocket port (default: 3000)
# PORT=3000
